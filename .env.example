# TeachBuddy — Einstellungen. Als `.env` kopieren und ausfüllen.
# Alles ist optional: Ohne Angaben läuft die App lokal mit dem mitgelieferten
# Inhalt, nur ohne Gesprächspartner.

# --- Gesprächspartner (OpenAI Realtime, E-20) --------------------------------
# Kostet pro Gesprächsminute; die App zeigt die Kosten mit (E-21).
TEACHBUDDY_OPENAI_API_KEY=
TEACHBUDDY_REALTIME_PREIS_PRO_MINUTE=0.05
TEACHBUDDY_WAEHRUNG=USD

# --- Erreichbarkeit -----------------------------------------------------------
# Standard ist nur dieser Rechner. Fürs Telefon im WLAN: 0.0.0.0 — und dann
# unbedingt einen Zugangscode. Einmal http://<rechner>:5089/?zugang=<code>
# öffnen, danach merkt sich das Gerät den Zugang.
TEACHBUDDY_APP_HOST=127.0.0.1
TEACHBUDDY_ZUGANGSCODE=
# TEACHBUDDY_APP_PORT=5089
# TEACHBUDDY_PORT=5088

# --- Wo die Dateien liegen (siehe pfade.py) ----------------------------------
# Deine eigene Bibliothek (python -m bibliothek.anlegen …); ohne Angabe die Demo.
# TEACHBUDDY_WISSEN=~/teachbuddy-bibliothek
# TEACHBUDDY_ARBEIT=./arbeit

# --- Nur für neue Inhalte: Vertonung über Azure OpenAI (POD-6) ---------------
TEACHBUDDY_AZURE_OPENAI_ENDPOINT=
TEACHBUDDY_AZURE_OPENAI_KEY=
TEACHBUDDY_AZURE_OPENAI_DEPLOYMENT=

# --- Nur für neue Inhalte: die Warteschlange (pipeline/nachtlauf.py) ---------
# Zeitfenster, in dem sie arbeitet (sie zieht aus dem Abo-Kontingent).
# TEACHBUDDY_FENSTER=21-8
# TEACHBUDDY_CODEX=/pfad/zur/codex
